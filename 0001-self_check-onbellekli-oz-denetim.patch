@@ -361,16 +374,24 @@ async def diag_sample_download(sha: str):
 @app.get("/api/v1/self_check")
 async def self_check_api():
     """Motorun ÖZ-DENETİMİ: canlı koda karşı tüm değişmez (invariant) testlerini çalıştırır.
