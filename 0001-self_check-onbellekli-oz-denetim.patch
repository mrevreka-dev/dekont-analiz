+async def _warm_self_check() -> None:
+    """Açılışta öz-denetim önbelleğini ısıt: diskteki son sonucu belleğe al ve arka
+    planda taze hesabı başlat. Böylece /api/v1/self_check ilk yoklamadan itibaren
